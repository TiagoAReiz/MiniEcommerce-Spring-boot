# MiniEcommerce — variáveis de ambiente
#
# Copie para .env e preencha. O .env é ignorado pelo git; este arquivo não deve
# conter nenhum valor real.
#
# Quem lê o quê:
#   docker compose  — lê .env sozinho, para as portas e credenciais da infra
#   a aplicação     — NÃO lê .env sozinho. Exporte antes de subir:
#                       set -a && . ./.env && set +a && ./mvnw spring-boot:run
#                     ou configure as variáveis no run configuration da IDE.
#
# Todas têm default no application.properties, menos as marcadas OBRIGATÓRIO.
# Sem elas a aplicação sobe, mas o recurso correspondente não funciona.


# ------------------------------------------------------------------ banco
# Host e porta apenas; o nome do banco está fixo na URL do datasource.
DB_HOST=localhost:5432

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres


# ------------------------------------------------------------------ redis
# Carrinho, cache de produto e a trava de idempotência do webhook.
REDIS_HOST=localhost
REDIS_PORT=6379


# ------------------------------------------------------------------ login com Google
# Emissor dos ID tokens. Só mude para apontar a um mock em teste.
GOOGLE_ISSUER=https://accounts.google.com

# OBRIGATÓRIO para o login funcionar.
#
# Client ID do OAuth 2.0 em console.cloud.google.com > APIs e serviços >
# Credenciais. Termina em .apps.googleusercontent.com.
#
# É contra este valor que a claim `aud` do ID token é verificada. Vazio, nenhum
# token passa — falha fechada, de propósito: sem essa checagem um ID token
# emitido para o app Google de qualquer outra pessoa entraria aqui.
GOOGLE_CLIENT_ID=

# OBRIGATÓRIO em produção.
#
# Segredo HMAC que assina os tokens desta API. No mínimo 32 bytes, aleatório.
# Gere com:  openssl rand -base64 48
#
# Quem tiver este valor emite token de qualquer usuário, inclusive OWNER. Nunca
# reaproveite o placeholder do application.properties fora de desenvolvimento.
JWT_SECRET=

# Claim `iss` dos tokens emitidos por esta API, e validada na entrada. Mudar
# invalida na hora todo token já emitido.
JWT_ISSUER=miniecommerce

# Validade do token. Curto reduz a janela de um token roubado; longo evita que
# o usuário refaça o login. Sem revogação, este é o único limite que existe.
JWT_TOKEN_TTL=1h


# ------------------------------------------------------------------ storage de imagens
# MinIO em desenvolvimento; em produção, o endpoint do S3 e credenciais IAM.
STORAGE_ENDPOINT=http://localhost:9000

# URL pública dos objetos: o endpoint, ou o CDN na frente dele. É o que vai
# dentro da URL da foto devolvida pela API, então precisa ser alcançável pelo
# navegador do cliente — não vale localhost em produção.
STORAGE_PUBLIC_URL=http://localhost:9000

STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

STORAGE_REGION=us-east-1
STORAGE_BUCKET=product-photos

# MinIO serve o bucket no caminho (host/bucket/objeto); o S3 real usa subdomínio
# (bucket.s3.amazonaws.com/objeto). Deixe true no MinIO, false no S3.
STORAGE_PATH_STYLE_ACCESS=true

# Limite por arquivo, em bytes. 5242880 = 5MB. Vale para as duas barreiras: a do
# multipart, que corta antes de carregar na memória, e a do service.
STORAGE_MAX_FILE_SIZE=5242880
STORAGE_MAX_REQUEST_SIZE=6291456

# Allow-list de tipos aceitos no upload, separados por vírgula. A checagem é por
# content type, não por extensão: um executável renomeado para .png continua
# sendo um executável.
STORAGE_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp

# Credenciais do container MinIO. Mantenha iguais às duas de cima em
# desenvolvimento, ou o cliente não autentica no bucket.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin


# ------------------------------------------------------------------ mercado pago
MP_BASE_URL=https://api.mercadopago.com

# OBRIGATÓRIO para cobrar.
#
# Access token em mercadopago.com.br/developers > Suas integrações >
# a aplicação > Credenciais. Use as de teste enquanto não for produção.
MP_ACCESS_TOKEN=

# OBRIGATÓRIO para o webhook aceitar qualquer coisa.
#
# Segredo em Suas integrações > a aplicação > Webhooks > Configurar notificação.
# É a chave HMAC que valida o header x-signature. Sem ela toda notificação é
# rejeitada com 401 — e é isso mesmo que tem que acontecer, porque o endpoint é
# público e liquida pedidos.
MP_WEBHOOK_SECRET=

# Para onde o Mercado Pago manda as notificações. Precisa ser alcançável da
# internet: em desenvolvimento, um túnel (ngrok, cloudflared) apontando para
# a aplicação local.
#   https://<seu-tunel>/webhooks/mercado-pago
MP_NOTIFICATION_URL=

# Para onde o cliente volta depois de pagar. Telas do seu front.
MP_SUCCESS_URL=http://localhost:3000/orders
MP_FAILURE_URL=http://localhost:3000/orders
MP_PENDING_URL=http://localhost:3000/orders

# Por quanto tempo uma notificação já processada é lembrada no Redis. Precisa
# cobrir a janela de retentativas do Mercado Pago, senão uma redelivery tardia
# seria tratada como nova.
MP_NOTIFICATION_MEMORY=24h

# Teto de conexão e de leitura nas chamadas à API deles. Sem isso, um gateway
# que aceita a conexão e emudece segura a thread da requisição.
MP_TIMEOUT=10s

# Rede de segurança do webhook. Como ele responde 200 antes de processar, o
# Mercado Pago não reenvia por conta própria: se o processamento em background
# falhar, um pedido já pago ficaria PENDING para sempre. Esta varredura pergunta
# ao gateway sobre cobranças abertas e nunca liquidadas.
#
# A janela tem as duas pontas de propósito: a mínima ignora cobranças recentes
# demais (o cliente ainda pode estar digitando o cartão) e a máxima para de
# consultar as antigas, que são carrinho abandonado.
MP_RECONCILIATION_INTERVAL=5m
MP_RECONCILIATION_MIN_AGE=5m
MP_RECONCILIATION_MAX_AGE=24h
MP_RECONCILIATION_BATCH_SIZE=50

# ------------------------------------------------------------------ reserva de estoque
# O checkout já baixa o estoque, antes de existir pagamento. Sem prazo, quem
# desiste na tela de pagamento deixa a prateleira vazia para todo mundo.
#
# expires_at é gravado no checkout e apagado quando o pedido é pago. Um pedido
# CANCELLED que ainda tem a data foi abandonado, e não cancelado à mão — é assim
# que a coluna vira histórico de venda perdida, com os itens e os preços junto.
ORDER_RESERVATION_WINDOW=30m

# Prazo maior, valendo a partir do momento em que a cobrança é aberta: o cliente
# está na tela de pagamento, e um pagamento aprovado cuja notificação se perdeu
# ainda é recuperável enquanto a reconciliação olhar para trás. Mantenha alinhado
# com MP_RECONCILIATION_MAX_AGE, ou a varredura cancela pedido que ainda ia ser
# liquidado.
ORDER_PAYMENT_WINDOW=24h

ORDER_EXPIRATION_INTERVAL=5m
ORDER_EXPIRATION_BATCH_SIZE=100


# ------------------------------------------------------------------ frete
# O frete é cobrado por distância: do CEP de origem da loja até o CEP do endereço
# de entrega. A origem não está aqui de propósito — ela vive na linha do owner e
# é definida por PUT /owners/origin, porque quem muda o endereço da loja é o
# operador, e uma variável de ambiente exigiria um redeploy para uma decisão que
# é de negócio. Definir a origem é passo obrigatório de instalação: enquanto ela
# for nula o checkout recusa com 409, porque todo pedido tem frete e entregar de
# graça por falta de configuração é o erro que só aparece na contabilidade.

# Preço por quilômetro de distância rodoviária estimada.
SHIPPING_PRICE_PER_KM=1.00

# Correção de linha reta para estrada. O CEP devolve coordenadas, não rotas, e a
# geodésica entre dois pontos fica cerca de um terço abaixo do trajeto real. É
# uma aproximação, e fica configurável justamente por não ser um fato.
SHIPPING_ROAD_FACTOR=1.3

# Tarifa fixa cobrada quando a loja tem origem configurada mas o lookup de CEP
# não produziu distância. Ela é errada para todo mundo por construção — o mesmo
# valor para quem está a três quilômetros e para quem está a oitocentos — e esse
# é o preço de não travar a venda por causa de um serviço de terceiro fora do ar.
# Os pedidos que a pagaram são exatamente os que ficam com shipping_distance_km
# nulo, e é assim que se conta com que frequência ela dispara.
SHIPPING_FALLBACK_COST=25.00

# Serviço que traduz CEP em coordenadas. A BrasilAPI agrega vários provedores e,
# ao contrário do ViaCEP, devolve latitude e longitude. As respostas ficam em
# cache no Redis por 30 dias: um CEP não muda de lugar, e o cache é o que faz uma
# instabilidade do provedor não ser sentida na maioria dos pedidos.
SHIPPING_CEP_BASE_URL=https://brasilapi.com.br

# Teto de conexão e de leitura no lookup de CEP. Curto de propósito: isso roda
# com o cliente parado no botão de finalizar, e a tarifa de contingência já é a
# resposta para um provedor lento ou mudo.
SHIPPING_TIMEOUT=3s


# ------------------------------------------------------------------ cors
# Origens que podem chamar esta API pelo navegador, separadas por vírgula.
# Sem isso o front é barrado antes de qualquer código da aplicação rodar.
# Listadas explicitamente, nunca com curinga: um curinga deixa qualquer página
# da internet dirigir a API com um token que ela tenha conseguido obter.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_MAX_AGE=1h
